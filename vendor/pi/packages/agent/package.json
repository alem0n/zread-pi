{
	"name": "@earendil-works/pi-agent-core",
	"version": "0.85.1",
	"description": "General-purpose agent with transport abstraction, state management, and attachment support",
	"type": "module",
	"private": true,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		},
		"./harness/context": {
			"types": "./dist/harness/context.d.ts",
			"import": "./dist/harness/context.js"
		},
		"./harness/env/nodejs": {
			"types": "./dist/harness/env/nodejs.d.ts",
			"import": "./dist/harness/env/nodejs.js"
		},
		"./harness/runtime/reducer": {
			"types": "./dist/harness/runtime/reducer.d.ts",
			"import": "./dist/harness/runtime/reducer.js"
		},
		"./harness/session": {
			"types": "./dist/harness/session/index.d.ts",
			"import": "./dist/harness/session/index.js"
		},
		"./harness/session/testing": {
			"types": "./dist/harness/session/testing/index.d.ts",
			"import": "./dist/harness/session/testing/index.js"
		},
		"./package.json": "./package.json"
	},
	"dependencies": {
		"@earendil-works/chord": "^0.85.1",
		"@earendil-works/pi-ai": "^0.85.1",
		"@earendil-works/pi-telemetry": "^0.85.1",
		"diff": "8.0.4",
		"ignore": "7.0.8",
		"typebox": "1.3.27",
		"yaml": "2.9.0"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
