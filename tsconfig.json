{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "declaration": false,
    "types": ["node", "bun-types"],
    "paths": {
      "@zread-pi/types": ["./packages/types/src/index.ts"],
      "@zread-pi/utils": ["./packages/utils/src/index.ts"],
      "@zread-pi/repo-analyzer": ["./packages/repo-analyzer/src/index.ts"],
      "@zread-pi/orchestrator": ["./packages/orchestrator/src/index.ts"],
      "@zread-pi/agent-runtime": ["./packages/agent-runtime/src/index.ts"]
    }
  },
  "include": [
    "apps/cli/src/**/*",
    "apps/cli/test/**/*",
    "packages/*/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "vendor",
    "dist",
    "archive"
  ]
}
