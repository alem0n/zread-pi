{
  "name": "@zread-pi/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "zread-pi 的 Agent 运行时适配层：对外保持原 agent-sdk 公共契约，内部由 pi（@earendil-works/pi-ai + pi-agent-core）提供 Agent 循环、多提供商请求、重试与工具执行。",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@zread-pi/types": "workspace:*",
    "@zread-pi/utils": "workspace:*"
  }
}
